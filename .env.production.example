# ===========================================
# Jinubify Production Environment (example)
# Copy to .env.production and fill in values.
# ===========================================

# --- Backend (Express) ---
NODE_ENV=production
PORT=5000
FRONTEND_URL=https://jinubify.com
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/jinubify?retryWrites=true&w=majority
JWT_SECRET=your-production-secret-at-least-32-characters-long
JWT_EXPIRES_IN=7d
MEDIA_BASE_URL=https://cdn.jinubify.com
LOG_LEVEL=info

# Optional: SMTP for contact form / notifications
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
CONTACT_EMAIL=contact@jinubify.com

# Optional: allow anonymous admin in dev only (do not use in production)
# ALLOW_ANONYMOUS_ADMIN=false

# --- Frontend (Next.js) - prefix with NEXT_PUBLIC_ for client exposure ---
NEXT_PUBLIC_SITE_URL=https://jinubify.com
NEXT_PUBLIC_API_URL=https://api.jinubify.com
NEXT_PUBLIC_MEDIA_BASE_URL=https://cdn.jinubify.com

# Optional: social links for SEO structured data
# NEXT_PUBLIC_SOCIAL_TWITTER=
# NEXT_PUBLIC_SOCIAL_LINKEDIN=
# NEXT_PUBLIC_SOCIAL_FACEBOOK=
